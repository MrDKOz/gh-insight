{
  "name": "ghinsight",
  "version": "2.1.4",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrDKOz/gh-insight"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "electron:dev": "cross-env ELECTRON=true vite",
    "build:electron": "cross-env ELECTRON=true tsc -p tsconfig.electron.json --noEmit && cross-env ELECTRON=true vite build && electron-builder"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.9",
    "@redgate/honeycomb-fonts": "^0.1.0",
    "@redgate/honeycomb-mui-theme": "^2.3.0",
    "fp-ts": "^2.16.11",
    "html-to-image": "^1.11.11",
    "io-ts": "^2.2.22",
    "jspdf": "^4.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "write-excel-file": "^3.0.8"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "1.1.13"
    }
  },
  "build": {
    "appId": "com.redgate.ghinsight",
    "productName": "GHInsight",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "MrDKOz",
      "repo": "gh-insight",
      "releaseType": "release"
    },
    "icon": "build/icon",
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/eslint-plugin": "^1.6.13",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vite-plugin-electron": "^0.29.1",
    "vitest": "^4.1.0"
  }
}
